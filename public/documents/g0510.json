{"id":"g0510","title":"Thrombocyten","description":"Anwendungsbeschreibung für das anthroposophische Organpräparat zur Behandlung von Immunthrombozytopenie. Mit Wirkungseintritt nach 7 bis 10 Tagen.","blocks":[{"type":"group","children":[{"type":"list","children":[{"type":"item","children":[{"type":"strong","children":[{"type":"text","text":"Hersteller"}]},{"type":"text","text":": WALA. "}]},{"type":"item","children":[{"type":"strong","children":[{"type":"text","text":"Zusammensetzung"}]},{"type":"text","text":": Thrombocyten equi Gl. "}]}]}]},{"type":"group","children":[{"type":"heading","level":2,"children":[{"type":"text","text":"Indikationen"}]}]},{"type":"group","id":"indication","children":[{"type":"group","children":[{"type":"heading","level":4,"children":[{"type":"group","children":[{"type":"text","text":" Idiopathische thrombozytopenische Purpura (ITP) "}]}]},{"type":"group","id":"a1265","children":[{"type":"group","children":[{"type":"group","children":[{"type":"paragraph","children":[{"type":"text","text":"Idiopathische thrombozytopenische Purpura (ITP), Autoimmunthrombozytopenie"}]}]},{"type":"group","children":[{"type":"list","children":[{"type":"item","children":[{"type":"strong","children":[{"type":"text","text":"Dosierung"}]},{"type":"text","text":": 1 x tgl. 1 Amp. D30 s.c. in der 1. Wo., "},{"type":"paragraph","children":[{"type":"text","text":"3 x/Wo. in der 2. Wo.,"}]},{"type":"paragraph","children":[{"type":"text","text":"2 x/Wo. in der 3. Wo.,"}]},{"type":"paragraph","children":[{"type":"text","text":"1 x/Wo. 1 Amp. D30 s.c. ab der 4. Wo."}]}]},{"type":"item","children":[{"type":"strong","children":[{"type":"text","text":"Wirkungseintritt"}]},{"type":"text","text":": Nach 7–10 Tg. steigen die Thrombozytenzahlen. "}]},{"type":"item","children":[{"type":"strong","children":[{"type":"text","text":"Therapiedauer"}]},{"type":"text","text":": 2–4 J. (immer wieder kurweise). "}]},{"type":"item","children":[{"type":"strong","children":[{"type":"text","