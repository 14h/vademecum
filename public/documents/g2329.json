{"id":"g2329","title":"Hamamelis Augentropfen","description":"Anwendung der Augentropfen zur Behandlung von Blutungen im Augengewebe (wie Netzhaut, Glaskörper und Bindehaut) sowie nach Thrombosen im Auge.","blocks":[{"type":"group","children":[{"type":"list","children":[{"type":"item","children":[{"type":"strong","children":[{"type":"text","text":"Bemerkungen:"}]},{"type":"text","text":" Hamamelis Decoctum D8 Augentropfen WELEDA nicht mehr erhältlich. Stattdessen magistrale Herstellung z.B. aus D6 Amp. WELEDA oder Amp. DHU. "}]},{"type":"item","children":[{"type":"strong","children":[{"type":"text","text":"Hersteller"}]},{"type":"text","text":": Rezepturpräparat. "}]}]}]},{"type":"group","children":[{"type":"heading","level":2,"children":[{"type":"text","text":"Indikationen"}]}]},{"type":"group","id":"indication","children":[{"type":"group","children":[{"type":"heading","level":4,"children":[{"type":"group","children":[{"type":"text","text":" Blutungen im Augengewebe "}]}]},{"type":"group","id":"a2132","children":[{"type":"group","children":[{"type":"group","children":[{"type":"text","text":" Wie Netzhaut, Glaskörper, Bindehaut. "},{"type":"list","children":[{"type":"item","children":[{"type":"text","text":" Nach Thrombosen im Auge. "}]}]}]},{"type":"group","children":[{"type":"list","children":[{"type":"item","children":[{"type":"strong","children":[{"type":"text","text":"Dosierung"}]},{"type":"text","text":": 2–3 x tgl. ins Auge tropfen. "}]},{"type":"item","children":[{"type":"strong","children":[{"type":"text","text":"Therapiedauer"}]},{"type":"text","text":": Einige Tage bis Wochen. "}]},{"type":"item","children":[{"type":"strong","children":[{"type":"text","text":"Nebenwirkungen"}]},{"type":"text","text":": Keine. "}]},{"type":"item","children":[{"type":"strong","children":[{"type":"text","text":"Berichtende Ärztin"}]},{"type":"text","text":": AuAa. "}]}]}]}]}]}]}]}]}