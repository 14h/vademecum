{"id":"g0942","title":"Endometrium","description":"Anwendungsbeschreibung für das anthroposophische Organpräparat Endometrium zur Behandlung bei Infertilität mit schwachem Aufbau des Endometriums.","blocks":[{"type":"group","children":[{"type":"list","children":[{"type":"item","children":[{"type":"strong","children":[{"type":"text","text":"Hersteller"}]},{"type":"text","text":": WALA. "}]},{"type":"item","children":[{"type":"strong","children":[{"type":"text","text":"Zusammensetzung"}]},{"type":"text","text":": Endometrium bovis Gl. "}]}]}]},{"type":"group","children":[{"type":"heading","level":2,"children":[{"type":"text","text":"Indikationen"}]}]},{"type":"group","id":"indication","children":[{"type":"group","children":[{"type":"heading","level":4,"children":[{"type":"group","children":[{"type":"text","text":" Infertilität mit schwachem Aufbau des Endometriums "}]}]},{"type":"group","id":"a2124","children":[{"type":"group","children":[{"type":"group","children":[{"type":"list","children":[{"type":"item","children":[{"type":"text","text":" Unerfüllter Kinderwunsch. "}]},{"type":"item","children":[{"type":"text","text":" Zwischenblutungen. "}]},{"type":"item","children":[{"type":"text","text":" Z.n. wiederholten Abrasiones mit folgenden Blutungsstörungen und Spotting (Schmierblutung). "}]},{"type":"item","children":[{"type":"text","text":" Im Ultraschall geringer Schleimhautaufbau < 8 mm endzyklisch. "}]}]}]},{"type":"group","children":[{"type":"list","children":[{"type":"item","children":[{"type":"strong","children":[{"type":"text","text":"Konstitution"}]},{"type":"text","text":": Jede Konstitution, sicher wirksam bei neurasthenischer Konstitution. "}]},{"type":"item","children":[{"type":"strong","children":[{"type":"text","text":"Dosierung"}]},{"type":"text","text":": 2–3 x/Wo. 1 Amp. D5 WALA s.c. in den Unterbauch. "}]},{"type":"item","children":[{"type":"strong","children":[{"type":"text","text":"Wirkungseintritt"}]},{"type":"text","text":": Für mindestens 3 Zyk