    <script>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/med/service-worker.js').then(function(registration) {
            console.log('Service Worker registered with scope:', registration.scope);
          if (navigator.serviceWorker.controller) {
            console.log('Service Worker ready');
            setupFavoriteButton();
          } else {
            console.log('Service Worker not ready');
            navigator.serviceWorker.oncontrollerchange = function() {
              console.log('Service Worker now ready');
              setupFavoriteButton();
            };
          }
        }).catch(function(error) {
          console.error('Service Worker registration failed:', error);
        });
      }

      function setupFavoriteButton() {

        $('body').on('click','[data-feedback-area-fav]', function(e) {
          e.preventDefault();
            const url = window.location.href;
            const title = document.title;

            navigator.serviceWorker.controller.postMessage({
                type: 'ADD_TO_FAVORITES',
                url,
                title
            });
            alert('Seite wurde zu den Favoriten hinzugefügt');
        });
      }

    </script>
